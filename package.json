{
  "name": "cargo-tracker",
  "private": true,
  "version": "4.0.0",
  "description": "PIA Dry Port — Cargo Tracker v4 (React + Supabase). Spécification métier : apps-script/ v3.6 + CONCEPTION_V4.md",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck -w web",
    "build": "npm run build -w web",
    "dev": "npm run dev -w web",
    "verifier:serveur": "tsc --noEmit --target esnext --module esnext --moduleResolution bundler --allowImportingTsExtensions --skipLibCheck supabase/functions/rpc/**/*.ts supabase/functions/_shared/domaine/src/*.ts"
  },
  "engines": {
    "node": ">=20"
  }
}
