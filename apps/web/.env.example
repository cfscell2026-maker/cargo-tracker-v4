# Copier vers .env.local (jamais commité) — valeurs du projet Supabase (région Europe)
VITE_SUPABASE_URL=https://<PROJET>.supabase.co
VITE_SUPABASE_ANON_KEY=<clé anon publique>

# SEC-02 — Double authentification (TOTP). ACTIVE par défaut.
# Doit rester cohérent avec MFA_REQUISE côté Edge Function : les deux se
# déploient ensemble. Ne la désactiver que par décision explicite et temporaire —
# l'application porte des données douanières.
VITE_MFA_REQUISE=true
