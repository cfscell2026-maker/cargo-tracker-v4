node_modules/
dist/
# Réglages locaux de l'outillage de développement (propres à un poste).
.claude/settings.local.json
.env
.env.*
!.env.example
*.local
.netlify/
# Cache de la CLI Supabase (référence du projet, URL du pooler, versions).
# Motif GÉNÉRAL : la CLI écrit ce dossier à côté du `supabase/` qu'elle trouve,
# donc pas forcément à la racine — un `.temp` s'était retrouvé commité sous
# packages/domaine/src/supabase/ après un lancement depuis le mauvais dossier.
**/.temp/
coverage/

# Exports Google Sheets (données douanières + hachages de mots de passe) — JAMAIS commités
*.xlsx
*.xls
comptes-provisoires.csv

# Sorties de la migration : dump complet de la base de production et listes de
# conteneurs/camions réels. Même raison que ci-dessus — ces fichiers ne quittent
# pas la machine de l'exploitant.
scripts/migration/backup_data.sql
scripts/migration/conteneurs-rejetes.csv
scripts/migration/supabase/.temp/
